# ─── Project context (skill 22 — Multi-Project Configuration) ───────────────
PROJECT_NAME=ISCORE-ASSETS
PROJECT_DOMAIN=Fixed Asset Management
TARGET_ENV=DEMO
AIR_GAPPED=false

# ─── Portal (IScore Fixed Asset Management Portal, Angular SPA, hash-routed) ─
PORTAL_BASE_URL=https://replace-with-portal-base-url/
PORTAL_LOGIN_PATH=#/login
# Optional: full login URL override; wins over BASE_URL + LOGIN_PATH when set.
# PORTAL_LOGIN_URL=

PORTAL_USERNAME=replace-with-portal-username
PORTAL_PASSWORD=replace-with-portal-password

# ─── CRM (Dynamics 365 on-prem, NTLM — skill 19) ────────────────────────────
CRM_BASE_URL=https://crm.cubicsystems.com
CRM_ORG_PATH=/ISCORE
# Use DOMAIN\username format for NTLM.
CRM_USERNAME=replace-with-crm-username
CRM_PASSWORD=replace-with-crm-password

# Tenant routing values consumed by config/resources.ts (skill 24).
# Committed defaults exist for the active project — set these only to override.
# CRM_APP_ID=a33fc2ad-6922-4822-92c5-4ec79ed129b0
# CRM_USER_ENTITY=cis_users
# CRM_AUTOMATION_USER_RECORD_ID=fd45443c-c79b-f111-a74f-000c290f08a3

# ─── Role model overrides (skill 19/20) ──────────────────────────────────────
# ROLE_LABEL_MAKER=Maker
# ROLE_LABEL_CHECKER=Checker
# ROLE_LABEL_FINANCE_CHECKER=Finance Checker

# ─── Shared test data (skill 24) ─────────────────────────────────────────────
