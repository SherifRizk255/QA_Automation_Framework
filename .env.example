# ─── Project context (skill 22 — Multi-Project Configuration) ───────────────
PROJECT_NAME=SAIB
TARGET_ENV=UAT
AIR_GAPPED=false

# ─── Portal (Internet Banking) ───────────────────────────────────────────────
PORTAL_BASE_URL=https://replace-with-base-url
PORTAL_LOGIN_PATH=/replace-with-login-path
# Optional: full login URL override; wins over BASE_URL + LOGIN_PATH when set.
# PORTAL_LOGIN_URL=

PORTAL_USERNAME=replace-with-username
PORTAL_PASSWORD=replace-with-password

# ─── CRM (Dynamics 365 on-prem, NTLM — skill 19) ────────────────────────────
CRM_BASE_URL=https://replace-with-crm-url
# Use DOMAIN\username format for NTLM.
CRM_USERNAME=replace-with-crm-username
CRM_PASSWORD=replace-with-crm-password

# Tenant routing values consumed by config/resources.ts (skill 24).
# Committed defaults exist for the active project — set these only to override.
# CRM_ORG_PATH_UAT=/SaibUAT
# CRM_ORG_PATH_MAIN=/Saib
# CRM_APP_ID=
# CRM_VIEW_ID_SMS_LOGS=
# CRM_VIEW_ID_BMA_TRANSFER_LOG=

# ─── Shared test data (skill 24) ─────────────────────────────────────────────
# TEST_TRANSFER_AMOUNT=77
# PORTAL_IB_USERNAME=OSerry

# ─── IScore Asset Management project (skill 22 — docs/projects/iscore-asset-management) ──
# Portal (Angular SPA, hash-routed).
ASSET_PORTAL_BASE_URL=https://replace-with-asset-portal-base-url
ASSET_PORTAL_LOGIN_PATH=/replace-with-asset-portal-login-path
# Optional: full login URL override; wins over BASE_URL + LOGIN_PATH when set.
# ASSET_PORTAL_LOGIN_URL=

ASSET_PORTAL_USERNAME=replace-with-asset-portal-username
ASSET_PORTAL_PASSWORD=replace-with-asset-portal-password

# CRM (Dynamics 365 on-prem, NTLM — skill 19). Separate auth context from the
# portal above; never share a storage state file between them.
ASSET_CRM_BASE_URL=https://replace-with-asset-crm-url
# Use DOMAIN\username format for NTLM.
ASSET_CRM_USERNAME=replace-with-asset-crm-username
ASSET_CRM_PASSWORD=replace-with-asset-crm-password

# Tenant routing values consumed by config/resources.ts (skill 24).
# ASSET_CRM_APP_ID=
# ASSET_CRM_ORG_PATH=
# ASSET_CRM_USER_RECORD_ID=

# ─── IScore Asset Management shared test data (skill 24) ────────────────────
